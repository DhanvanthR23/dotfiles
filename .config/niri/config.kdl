// ============================================================================
// NIRI CONFIGURATION - noctalia-shell (merged from noctalia + iNiR)
// ============================================================================

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
    honor-xdg-activation-with-invalid-serial
}

// ============================================================================
// OUTPUTS
// ============================================================================

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    focus-at-startup
    position x=-1920 y=-100
}

output "eDP-1" {
    mode "1920x1080@60.004"
    scale 1.0
    position x=0 y=0
}

// ============================================================================
// INPUT
// ============================================================================

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 275
        repeat-rate 45
        numlock
    }
    touchpad {
        tap
        tap-button-map "left-right-middle"
    }
    mouse {
        accel-profile "flat"
    }
    focus-follows-mouse max-scroll-amount="0%"

    mod-key "Super"
    mod-key-nested "Alt"
}

// ============================================================================
// LAYOUT
// ============================================================================

layout {
    gaps 8
    background-color "#232136"
    center-focused-column "never"

    preset-column-widths {
        proportion 1.0
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        width 1.5
        active-color "#56526e"
        inactive-color "#6e6a86"
        urgent-color "#eb6f92"
    }

    border {
        on
        width 1
        active-color "#56526e"
        inactive-color "#6e6a86"
        urgent-color "#eb6f92"
    }

    shadow {
        on
        softness 20
        spread 5
        offset x=0 y=5
        color "#23213688"
    }

    tab-indicator {
        width 2
        gap -5
        gaps-between-tabs 5
        corner-radius 10
        active-color "#56526e"
        inactive-color "#6e6a86"
        urgent-color "#eb6f92"
    }

    insert-hint {
        color "#3e8fb080"
    }

    struts { }
}

recent-windows {
    highlight {
        active-color "#56526e"
        urgent-color "#eb6f92"
    }
}

include "~/.config/colors/colors.kdl"

gestures {
    hot-corners {
        off
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

overview {
    backdrop-color "#232136"
    zoom 0.5
}

// ============================================================================
// ENVIRONMENT
// ============================================================================

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_MENU_PREFIX "plasma-"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_LOGGING_RULES "quickshell.dbus.properties=false"
}

// ============================================================================
// STARTUP
// ============================================================================


spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "hypridle"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "sh" "-c" "~/.config/niri/scripts/swww-restore.sh"
spawn-at-startup "sh" "-c" "sleep 2; systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR; systemctl --user restart xdg-desktop-portal-gtk xdg-desktop-portal"

// ============================================================================
// WINDOW RULES
// ============================================================================

window-rule {
    geometry-corner-radius 15
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.95
}

// Firefox PiP always floating
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// ============================================================================
// LAYER RULES
// ============================================================================

layer-rule {
    match namespace="^noctalia-overview*"
    place-within-backdrop true
}

// ============================================================================
// ANIMATIONS
// ============================================================================

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
    }
    window-open {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.1
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.90 stiffness=800 epsilon=0.0001
    }
    screenshot-ui-open {
        spring damping-ratio=0.85 stiffness=750 epsilon=0.0001
    }
}

// ============================================================================
// KEYBINDINGS
// ============================================================================

binds {
    //Mod+D { spawn "qs" "ipc" "call" "ui" "toggleLauncher"; }
    //Mod+A { spawn "qs" "ipc" "call" "ui" "toggleControlCenter"; }
    //Ctrl+Alt+Delete { spawn "qs" "ipc" "call" "ui" "togglePowerMenu"; }

    // Tier 2: OSD Volume hooks
    //XF86AudioRaiseVolume { spawn "fish" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && qs ipc call ui showOsd Vol $(wpctl get-volume @DEFAULT_AUDIO_SINK@)"; }
    //XF86AudioLowerVolume { spawn "fish" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && qs ipc call ui showOsd Vol $(wpctl get-volume @DEFAULT_AUDIO_SINK@)"; }
    
    //Mod+Shift+N { spawn "fish" "-c" "killall gammastep || gammastep -O 3500 &"; }
    //Mod+V { spawn "qs" "ipc" "call" "clipboard" "toggle"; }
    //Mod+Ctrl+T { spawn "qs" "ipc" "call" "wallpaper" "toggle"; }
    //Mod+L { spawn "qs" "ipc" "call" "lockscreen" "lock"; }

    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+H { spawn "sh" "-c" "~/.config/niri/scripts/toggle-idle.fish"; }
    Mod+TAB repeat=false hotkey-overlay-title="Toggle Overview" { toggle-overview; }
    Mod+Shift+D {spawn "sh" "-c" "~/.config/niri/scripts/file-search.sh";}

    // legacy commands
     Mod+D { spawn "fuzzel"; }
     Mod+V {spawn "sh" "-c" "pkill -x fuzzel || cliphist list | fuzzel --dmenu --placeholder 'clipboard...' --with-nth=2 | cliphist decode | wl-copy";}
     Mod+Shift+N { spawn "makoctl" "dismiss" "--all"; }
     Mod+Ctrl+T { spawn "waypaper";}
     Mod+L {spawn "sh" "-c" "~/.config/niri/scripts/lock.sh";}
     Mod+Shift+U { spawn "sh" "-c" "rm -f /run/user/1000/waybar-updates.cache; pkill -SIGRTMIN+8 waybar"; }
     XF86AudioRaiseVolume hotkey-overlay-title="Increase Volume" { spawn "sh" "-c" "~/.config/niri/scripts/volume-up.sh"; } 
     XF86AudioLowerVolume hotkey-overlay-title="Decrease Volume" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
     Mod+Shift+W {spawn "sh" "-c" "pkill waybar; sleep 0.3; waybar &";}
     Mod+Escape { spawn "sh" "-c" "~/.config/niri/scripts/session.sh";}

    // Screenshots
    Mod+Shift+S { screenshot show-pointer=false; }
    Ctrl+Print { screenshot-screen show-pointer=false; }
    Alt+Print { screenshot-window; }

    // Applications
    Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "foot"; }
    Mod+E hotkey-overlay-title="Open File Manager" { spawn "nautilus"; }
    Mod+B hotkey-overlay-title="Open Brave" { spawn "brave-origin"; }
    Mod+Shift+B hotkey-overlay-title="Open Chrome" { spawn "google-chrome-stable"; }
    Mod+M hotkey-overlay-title="Open Thunderbird" { spawn "thunderbird"; }
    Ctrl+Shift+Escape hotkey-overlay-title="System Monitor" { spawn "foot" "-e" "btop" "--force-utf"; }
    Mod+Shift+C hotkey-overlay-title="Color Picker" { spawn "hyprpicker" "-a"; }

    // Window management
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Alt+Space { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Column/window sizing
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Column tiling
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Shift+Period { expel-window-from-column; }

    // Focus (arrow keys)
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }

    // Move windows
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    // Monitor focus/move
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Column first/last
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }

    // Workspace navigation
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }

    // Workspaces by number
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Scroll workspace navigation
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Volume
    XF86AudioMute hotkey-overlay-title="Mute Output" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute hotkey-overlay-title="Mute Input" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // Brightness
    XF86MonBrightnessUp hotkey-overlay-title="Increase Brightness" { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown hotkey-overlay-title="Decrease Brightness" { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Media
    XF86AudioNext hotkey-overlay-title="Next Song" { spawn-sh "playerctl next"; }
    XF86AudioPause hotkey-overlay-title="Pause Music" { spawn-sh "playerctl play-pause"; }
    XF86AudioPlay hotkey-overlay-title="Play Music" { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev hotkey-overlay-title="Previous Music" { spawn-sh "playerctl previous"; }
}


