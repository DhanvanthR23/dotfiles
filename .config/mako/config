# ~/.config/mako/config
# Rosé Pine — lean, no animation overhead, grouping enabled

# ── Colors ─────────────────────────────────────────────
include=~/.config/colors/colors-mako.ini

# ── Layout ────────────────────────────────────────────
sort=-time
layer=overlay
anchor=top-right
margin=12
padding=12,16
width=340
height=120
max-visible=5
max-history=20

# ── Appearance ────────────────────────────────────────
font=JetBrainsMono Nerd Font 11
border-size=1
border-radius=8
icon-location=left
markup=1
actions=1

# ── Timing ────────────────────────────────────────────
default-timeout=5000
ignore-timeout=0

# ── Urgency: low ──────────────────────────────────────
[urgency=low]
default-timeout=4000

# ── Urgency: normal ───────────────────────────────────
[urgency=normal]
default-timeout=5000

# ── Urgency: high (critical) ──────────────────────────
[urgency=high]
border-size=2
default-timeout=0

# ── App-specific overrides ────────────────────────────
[app-name="volume-notify"]
default-timeout=2000
